{
  "name": "@ara/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --enable-source-maps src/main.ts",
    "demo": "DEMO_MODE=offline SEARCH_PROVIDER=fixture node --enable-source-maps src/main.ts",
    "live": "node --watch --env-file-if-exists=../../.env.local --enable-source-maps src/main.ts",
    "start": "pnpm build && node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ara/shared": "workspace:*",
    "axios": "^1.13.1",
    "express": "^5.1.0",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.13",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "msw": "^2.12.4",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
