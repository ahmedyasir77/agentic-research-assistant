{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "moduleDetection": "force",
    "strict": true,

    // The rules of engagement forbid `any` and unchecked casts, so the compiler
    // has to be the thing that enforces them — not code review.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,

    // `erasableSyntaxOnly` keeps the source runnable by Node's native type
    // stripping: no enums, no parameter properties, no runtime-bearing syntax.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  }
}
