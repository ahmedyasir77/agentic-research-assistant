# Copy to .env and edit. Every variable has a working default: with no .env at all
# the app boots in offline demo mode, needs no keys, and makes no network calls.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# live    — call the real Anthropic and search APIs (needs keys below)
# offline — replay recorded LLM turns and search results from fixtures/
DEMO_MODE=offline

# --- Model -------------------------------------------------------------------
# Required when DEMO_MODE=live. Never commit a real key.
ANTHROPIC_API_KEY=
# Read from config, never hardcoded in source, so the model is a deploy-time choice.
MODEL_ID=claude-opus-5

# --- Search ------------------------------------------------------------------
# fixture — read fixtures/search/*.json (the only option when DEMO_MODE=offline)
# tavily  — call the Tavily API (needs TAVILY_API_KEY)
SEARCH_PROVIDER=fixture
TAVILY_API_KEY=

# --- Agent budgets -----------------------------------------------------------
# The rails. Exceeding any of these ends the run with a partial answer and a
# budget_exceeded reason — never an unhandled rejection.
MAX_STEPS=8
MAX_WALL_CLOCK_MS=60000
MAX_TOOL_CALLS_PER_STEP=3
MAX_OUTPUT_TOKENS=4096

# --- Ingress -----------------------------------------------------------------
# Runs started per IP per minute.
RATE_LIMIT_PER_MIN=10

# --- Fixtures ----------------------------------------------------------------
# Where recorded LLM turns, search results and pages live. Defaults to the repo's
# fixtures/ directory; set this explicitly when the app runs from a container.
FIXTURES_DIR=
